},
{
  id: "trig", title: "Trigonometry", klasse: 9, area: "geometrie",
  x: -808, y: 2003, requires: ["pythagoras"],
  teaser: "From a shadow and an angle to the height of a mountain – welcome to sine and cosine.",
  desc: "Angles and lengths, finally connected: measuring the unreachable.",
  exercises: [
    { q: "In right triangles with a 30° angle, the ratio opposite/hypotenuse is ALWAYS …",
      type: "choice",
      choices: ["the same value: sin(30°) = 0.5, whatever the size", "different for every triangle", "half the adjacent side", "impossible to know"],
      answer: 0,
      hints: ["All right triangles with 30° are similar (same shape!).", "Similar shapes → equal ratios. That was your scale topic!"],
      why: "<b>sin, cos, tan are ratios</b> – similarity guarantees they only depend on the angle. That's the whole secret of trigonometry." },
    { q: "A ramp rises at 30°; its slanted length is 8 m. Height = 8 · sin(30°) = ? (m)",
      type: "number", answer: 4, unit: "m",
      hints: ["sin(30°) = 0.5.", "8 · 0.5 = ?"],
      why: "sin = opposite/hypotenuse → opposite = hypotenuse · sin. <b>One angle + one side = everything.</b>" },
    { q: "tan(45°) = ?",
      type: "number", answer: 1,
      hints: ["45° makes the triangle isosceles: opposite = adjacent.", "Equal numbers divided: ?"],
      why: "tan = opposite/adjacent. At 45° both legs match – tan(45°) = <b>1</b>: the 100 % slope." },
    { q: "You see a tower top at 45° elevation; the tower is 25 m tall. How far are you from its base?",
      type: "choice", choices: ["25 m – tan(45°) = 1 means height = distance", "50 m", "12.5 m", "need more information"], answer: 0,
      hints: ["tan(45°) = height : distance.", "1 = 25 : distance."],
      why: "<b>Measuring without touching</b>: surveyors, sailors and astronomers have lived off this for centuries." }
  ]
},
{
  id: "ungleich", title: "Inequalities", klasse: 9, area: "algebra",
  x: 668, y: -2054, requires: ["gleich1"],
  teaser: "Equations pin down ONE number. Inequalities capture whole ranges – like real life.",
  desc: "More-than and less-than: computing with ranges.",
  exercises: [
    { q: "x + 3 < 10 means …",
      type: "choice", choices: ["x < 7", "x = 7", "x > 7", "x < 13"], answer: 0,
      hints: ["Treat it like an equation: −3 on both sides.", "The < stays put."],
      why: "Inequalities solve like equations – the solution is a whole <b>range</b>: every number below 7." },
    { q: "Careful! −2x < 6. Then …",
      type: "choice", choices: ["x > −3 (flip the sign!)", "x < −3", "x < 3", "x > 3"], answer: 0,
      hints: ["Divide by −2 – but test it: is x = 0 a solution of −2x < 6?",
              "−2·0 = 0 < 6 ✓. So 0 must be in your solution range. Which option contains 0?"],
      why: "Multiplying/dividing by a NEGATIVE number <b>flips</b> the inequality – mirrors reverse order!" },
    { q: "Taxi budget: you have €20. Base fare €4 + €2/km: 4 + 2x ≤ 20. How many km at most?",
      type: "number", answer: 8, unit: "km",
      hints: ["−4 on both sides: 2x ≤ 16.", "Divide by 2."],
      why: "Budgets, speed limits, minimum ages: the world is full of <b>constraints</b> – inequalities compute them." },
    { q: "Why does the sign flip when multiplying by −1? On the number line, negation …",
      type: "choice",
      choices: ["mirrors everything: 2 < 3 but −2 > −3", "makes numbers smaller", "is just a convention", "moves everything left"],
      answer: 0,
      hints: ["Take 2 < 3. Where do −2 and −3 sit?", "−3 lies further left than −2."],
      why: "Mirroring <b>reverses order</b> – see it once on the number line and you'll never forget the rule." }
  ]
},
{
  id: "potrat", title: "Exponents Unleashed", klasse: 9, area: "zahlen",
  x: 2054, y: -668, requires: ["potenzen", "wurzeln"],
  teaser: "What could 2⁰ or 2⁻¹ possibly mean? The pattern decides – and it's beautiful.",
  desc: "Zero, negative and fractional exponents: the power laws take over.",
  exercises: [
    { q: "The pattern: 2³ = 8, 2² = 4, 2¹ = 2 – each step divides by 2. So 2⁰ = ?",
      type: "choice", choices: ["1", "0", "2", "undefined"], answer: 0,
      hints: ["Keep dividing: 2 : 2 = ?", "The pattern must continue seamlessly."],
      why: "a⁰ = 1 is no arbitrary rule – <b>the pattern demands it</b>. (Same reasoning as minus·minus!)" },
    { q: "Continue the pattern once more: 2⁻¹ = ?",
      type: "choice", choices: ["1/2", "−2", "−1/2", "0.1"], answer: 0,
      hints: ["After 2⁰ = 1 comes another ÷2.", "1 : 2 = ?"],
      why: "Negative exponent = <b>reciprocal</b>: a⁻ⁿ = 1/aⁿ. Powers now reach below 1." },
    { q: "10⁻³ · 10⁵ = 10^?",
      type: "number", answer: 2,
      hints: ["Exponents add: −3 + 5.", "That's the same law as before – it survives!"],
      why: "The <b>old law still holds</b> with the new exponents. Good definitions keep old rules alive." },
    { q: "9^(1/2) = ? The law forces it: 9^(1/2) · 9^(1/2) = 9¹.",
      type: "choice", choices: ["3 – the square root!", "4.5", "81", "1/9"], answer: 0,
      hints: ["Which number times itself gives 9?", "9^(1/2) must be exactly that number."],
      why: "Fractional exponents ARE <b>roots</b> – powers and roots merge into one idea. The pattern wins again." }
  ]
},

{
  id: "aehnlich", title: "Similar Figures & Intercept Theorem", klasse: 9, area: "geometrie",
  x: -1254, y: 1759, requires: ["massstab"],
  teaser: "Same shape, different size — and a theorem that measures the unreachable, from tree heights to star distances.",
  desc: "Scaled copies: equal angles, proportional sides, and the intercept theorem.",
  exercises: [
    { q: "Two triangles are similar with scale factor 3. A side of length 4 in the small one becomes ? in the big one.",
      type: "choice", choices: ["12","7","4/3","1.5"], answer: 0,
      hints: ["Similar = every length times the same factor.","4 · 3."],
      why: "<b>Similarity</b> multiplies every length by one factor while angles stay put." },
    { q: "A 2 m pole casts a 1.5 m shadow. A tree casts a 12 m shadow at the same time. Tree height? (m)",
      type: "number", answer: 16, unit: "m",
      hints: ["Same sun -> similar triangles: height/shadow is constant.","2/1.5 = h/12."],
      why: "The <b>intercept theorem</b> measures the unreachable — Thales found a pyramid's height this way." },
    { q: "In two similar figures, what stays exactly the same?",
      type: "choice", choices: ["the angles","the side lengths","the area","the perimeter"], answer: 0,
      hints: ["Similar = same shape.","Only the size changes."],
      why: "<b>Angles are preserved</b> under scaling; lengths all change by the same factor." },
    { q: "Two similar triangles have scale factor 2. The small one has area 5. The big one's area is … (area scales by factor²)",
      type: "number", answer: 20,
      hints: ["Area grows by k² = 2² = 4.","5 · 4."],
      why: "Lengths scale by k, but <b>area scales by k²</b> — doubling sides quadruples area." }
  ]
},
{
  id: "kreiswinkel", title: "Circle Angles & Thales", klasse: 9, area: "geometrie",
  x: -1543, y: 1745, requires: ["kreis"],
  teaser: "Every angle drawn in a semicircle is a perfect right angle — Thales' 2500-year-old surprise.",
  desc: "Inscribed and central angles, and Thales' theorem hiding right angles in circles.",
  exercises: [
    { q: "A triangle whose longest side is the diameter of its circle has one angle of exactly …",
      type: "choice", choices: ["90°","60°","45°","120°"], answer: 0,
      hints: ["This is Thales' theorem.","Semicircle -> right angle."],
      why: "<b>Thales' theorem</b>: the diameter always sees a right angle." },
    { q: "An inscribed angle is half its central angle. Central angle 80° -> inscribed angle = ? (°)",
      type: "number", answer: 40, unit: "°",
      hints: ["Inscribed = central / 2.","80 / 2."],
      why: "The <b>inscribed-angle theorem</b> — one elegant rule behind much of circle geometry." },
    { q: "A central angle of 100° gives an inscribed angle on the same arc of … (°)",
      type: "number", answer: 50, unit: "°",
      hints: ["Inscribed = half the central angle.","100 / 2."],
      why: "The <b>inscribed-angle theorem</b> again — half, every time." },
    { q: "Thales' theorem lets you construct a right angle using a semicircle and a …",
      type: "choice", choices: ["compass","calculator","protractor with numbers","stopwatch"], answer: 0,
      hints: ["How do you draw a circle?","A twin-legged tool."],
      why: "With just a <b>compass</b> you can build perfect right angles — no protractor needed." }
  ]
},
{
  id: "sinuskos", title: "Sine & Cosine Rule", klasse: 9, area: "geometrie",
  x: -1147, y: 2028, requires: ["trig"],
  teaser: "Triangles without a right angle? Two rules unlock every side and angle anyway.",
  desc: "Beyond right triangles: the law of sines and the law of cosines.",
  exercises: [
    { q: "When the angle is 90°, the law of cosines turns into which famous theorem?",
      type: "choice", choices: ["Pythagoras","Thales","Intercept theorem","none"], answer: 0,
      hints: ["cos 90° = 0, so the extra term vanishes.","a² + b² = c²."],
      why: "The <b>law of cosines</b> is Pythagoras with a correction term for non-right angles." },
    { q: "Law of sines: a/sin A = b/sin B. If a = 10, sin A = 0.5 and sin B = 1, then b = ?",
      type: "number", answer: 20,
      hints: ["a/sin A = 10/0.5 = 20.","b = 20 · sin B."],
      why: "The <b>law of sines</b> links every side to the angle opposite it." },
    { q: "You know two sides and the angle BETWEEN them. Which rule finds the third side?",
      type: "choice", choices: ["law of cosines","law of sines","Thales","none"], answer: 0,
      hints: ["Side–angle–side.","The one with a cos term."],
      why: "The <b>law of cosines</b> handles side–angle–side directly." },
    { q: "Law of cosines c² = a² + b² − 2ab·cos C. With a=3, b=4, C=90° (cos 90°=0): c = ?",
      type: "number", answer: 5,
      hints: ["The last term vanishes: c² = 9 + 16.","√25."],
      why: "At 90° it collapses to <b>Pythagoras</b> — 3-4-5." }
  ]
},
{
  id: "baumdiagramm", title: "Tree Diagrams & Two-Stage Chance", klasse: 9, area: "daten",
  x: -170, y: -2243, requires: ["wahrsch"],
  teaser: "Draw chance as branches — multiply along a path, add across paths. Two-stage experiments made easy.",
  desc: "Path rules for multi-stage random experiments using tree diagrams.",
  exercises: [
    { q: "Flip two fair coins. P(both heads) = 1/2 · 1/2 = ? (decimal)",
      type: "number", answer: 0.25,
      hints: ["Multiply along the branch.","0.5 · 0.5."],
      why: "<b>Along a path you multiply.</b> Independent stages combine by multiplication." },
    { q: "On a tree diagram you ___ along a branch and ___ across different paths.",
      type: "choice", choices: ["multiply / add","add / multiply","add / add","multiply / multiply"], answer: 0,
      hints: ["One path = a sequence of steps; several paths = alternatives.","Steps -> ·, alternatives -> +."],
      why: "The <b>path rules</b>: multiply within a path, add between paths." },
    { q: "P(red) = 0.3. Draw twice with replacement. P(red then red) = 0.3 · 0.3 = ?",
      type: "number", answer: 0.09,
      hints: ["Multiply along the path.","0.3 · 0.3."],
      why: "Independent draws <b>multiply</b> along the branch." },
    { q: "All the branches leaving a single point on a tree always add up to …",
      type: "choice", choices: ["1","0","0.5","100"], answer: 0,
      hints: ["Something must happen.","Total probability."],
      why: "Probabilities out of one node sum to <b>1</b> — a complete set of outcomes." }
  ]
},

{
  id: "saeuren", title: "Acids & Bases", klasse: 9, area: "chemie",
  x: 2295, y: 838, requires: ["reaktionen"],
  teaser: "Lemon stings, soap is slippery — a hidden scale from 0 to 14 ranks them all.",
  desc: "Acids, bases and the pH scale.",
  exercises: [
    { q: "The scale that measures how acidic something is runs from …",
      type: "choice", choices: ["0 to 14","0 to 100","1 to 10","−5 to 5"], answer: 0,
      hints: ["The pH scale.","Fourteen steps."],
      why: "The <b>pH scale</b> runs 0 (very acidic) to 14 (very basic)." },
    { q: "On the pH scale, neutral (like pure water) is exactly …",
      type: "number", answer: 7,
      hints: ["The middle of 0–14.","Half of 14."],
      why: "<b>pH 7</b> is neutral — neither acid nor base." },
    { q: "Lemon juice is …",
      type: "choice", choices: ["acidic","basic","neutral","a metal"], answer: 0,
      hints: ["It tastes sour.","Low pH."],
      why: "Sour foods like lemon are <b>acidic</b> (pH below 7)." },
    { q: "An acid and a base react to neutralise each other, forming a salt and …",
      type: "choice", choices: ["water","gold","more acid","air"], answer: 0,
      hints: ["The universal product.","H and OH join."],
      why: "<b>Neutralisation</b> makes a salt plus water." }
  ]
},
{
  id: "oekosystem", title: "Ecosystems & Food Webs", klasse: 9, area: "bio",
  x: -2209, y: 1044, requires: ["leben"],
  teaser: "Grass feeds the rabbit, the rabbit feeds the fox — energy flows through nature in linked chains.",
  desc: "How living things depend on each other in food chains and webs.",
  exercises: [
    { q: "In a food chain, the energy originally comes from …",
      type: "choice", choices: ["the Sun","the soil","rocks","the moon"], answer: 0,
      hints: ["Plants capture it first.","Photosynthesis again."],
      why: "Nearly all food chains trace back to <b>the Sun</b>." },
    { q: "'Grass → rabbit → fox' is an example of a …",
      type: "choice", choices: ["food chain","water cycle","rock cycle","machine"], answer: 0,
      hints: ["Who eats whom.","Energy passed along."],
      why: "A <b>food chain</b> shows energy flowing from one living thing to the next." },
    { q: "Animals that eat only plants are called …",
      type: "choice", choices: ["herbivores","carnivores","minerals","predators only"], answer: 0,
      hints: ["Cows and rabbits.","'Herb' = plant."],
      why: "<b>Herbivores</b> eat plants; carnivores eat meat." },
    { q: "If all the rabbits vanished, the foxes would likely …",
      type: "choice", choices: ["have less food","grow wings","turn into plants","be unaffected"], answer: 0,
      hints: ["Foxes eat rabbits.","Break the chain."],
      why: "Remove one link and the whole <b>web</b> feels it." }
  ]
},

{
  id: "wetter", title: "Weather & Climate", klasse: 9, area: "astro",
  x: -170, y: -2554, requires: ["erde"],
  teaser: "Sun, water and wind stir the atmosphere into rain and storms — and the long-run patterns we call climate.",
  desc: "The water cycle, weather, and how climate differs from weather.",
  exercises: [
    { q: "The Sun evaporates water, clouds form, then rain falls. This loop is the …",
      type: "choice", choices: ["water cycle","rock cycle","food chain","orbit"], answer: 0,
      hints: ["Water going round and round.","Evaporation → rain."],
      why: "The <b>water cycle</b> recycles Earth's water endlessly." },
    { q: "Weather is the day-to-day state of the air; climate is the …",
      type: "choice", choices: ["long-term average","weather right now","same as a storm","temperature of space"], answer: 0,
      hints: ["Years, not hours.","Typical pattern."],
      why: "<b>Climate</b> is the long-run average; weather is today." },
    { q: "Clouds are made of tiny droplets of …",
      type: "choice", choices: ["water","smoke","dust only","sand"], answer: 0,
      hints: ["They fall as rain.","Evaporated then cooled."],
      why: "Clouds are countless tiny <b>water</b> droplets." },
    { q: "Wind is simply moving …",
      type: "choice", choices: ["air","water","rock","light"], answer: 0,
      hints: ["You feel it but can't see it.","Air on the move."],
      why: "<b>Wind</b> is air flowing from high to low pressure." }
  ]
},

