      why: "A <b>simile</b> compares using 'like' or 'as'." },
    { q: "Saying one thing IS another (the world's a stage) is a …",
      type: "choice", choices: ["metaphor","simile","comma","verb"], answer: 0,
      hints: ["A direct comparison, no 'like'.","'Time is a thief.'"],
      why: "A <b>metaphor</b> states one thing is another." },
