/* ================= GRADE 11 ================= */
{
  id: "komplex", title: "Complex Numbers", klasse: 11, area: "zahlen",
  x: 2511, y: -816, requires: ["quadgl"],
  teaser: "x² = −1 is impossible … until mathematicians invented a number that makes it possible. Meet i.",
  desc: "The boldest extension of the number world – and physics runs on it.",
  exercises: [
    { q: "The imaginary unit i is defined by …",
      type: "choice", choices: ["i² = −1", "i = −1", "i = 0", "i² = 1"], answer: 0,
      hints: ["Exactly the 'impossible' equation gets a solution by decree.", "A new number whose square is −1."],
      why: "Numbers were <b>invented</b> before: negatives, fractions, irrationals. i is the same move once more – bold but consistent." },
    { q: "(2 + 3i) + (4 − i) = ?",
      type: "choice", choices: ["6 + 2i", "6 + 4i", "8 + 2i", "2 − 3i"], answer: 0,
      hints: ["Real parts together, imaginary parts together.", "2+4 = 6 and 3−1 = 2."],
      why: "Complex arithmetic = <b>familiar rules</b>, one new symbol. Nothing mystical about the mechanics." },
    { q: "i⁴ = ?",
      type: "number", answer: 1,
      hints: ["i² = −1, so i⁴ = (i²)².", "(−1)² = ?"],
      why: "Powers of i cycle: i, −1, −i, 1, i, … – a <b>rotation</b> in disguise." },
    { q: "Complex numbers live …",
      type: "choice",
      choices: ["on a PLANE: real axis + imaginary axis", "on the number line", "nowhere", "only inside equations"],
      answer: 0,
      hints: ["One number line wasn't enough anymore.", "a + bi needs TWO coordinates: (a, b)."],
      why: "ℕ→ℤ→ℚ→ℝ→<b>ℂ</b>: the last great expansion. Electronics, quantum physics and signal processing compute in it daily." }
  ]
},
{
  id: "diff", title: "Derivatives", klasse: 11, area: "analysis",
  x: 1438, y: -2214, requires: ["folgen", "quadfunk"],
  teaser: "Your speedometer shows the speed at one INSTANT. But speed = distance/time needs two moments … or does it?",
  desc: "The mathematics of change – calculus, part one.",
  exercises: [
    { q: "Distance s = t². Average speed from t=1 to t=2: (4−1)/(2−1) = 3. And AT the instant t=1?",
      type: "choice",
      choices: ["Shrink the interval: the values 3, 2.5, 2.1, 2.01, … head to 2", "Exactly 3", "0", "Undefined forever"],
      answer: 0,
      hints: ["Try t=1 to 1.1: (1.21−1)/0.1 = 2.1. Then to 1.01 …", "A limit! Your sequences topic returns."],
      why: "Instant speed = <b>limit of average speeds</b>. The 'impossible' 0/0 gets tamed by limits." },
    { q: "The derivative f'(x) is, geometrically, …",
      type: "choice",
      choices: ["the slope of the tangent – secant slopes in the limit", "the y-value", "the area under f", "the mean of f"],
      answer: 0,
      hints: ["Zoom into any smooth curve: it looks ever straighter.", "The line it approaches touches in one point: the tangent."],
      why: "<b>Zoom in far enough and every smooth curve is a line</b> – its slope is the derivative. Change, measured pointwise." },
    { q: "The rule you just discovered: (x²)' = 2x. Slope of y = x² at x = 3?",
      type: "number", answer: 6,
      hints: ["Just substitute into 2x.", "2 · 3 = ?"],
      why: "One formula gives the slope <b>everywhere at once</b> – infinitely many tangents in one term." },
    { q: "Also: (x³)' = 3x². Slope of y = x³ at x = 2?",
      type: "number", answer: 12,
      hints: ["3 · x² with x = 2.", "3 · 4 = ?"],
      why: "The pattern (xⁿ)' = n·xⁿ⁻¹ – <b>the power rule</b>. Calculus turns out to be… learnable!" }
  ]
},
{
  id: "kurven", title: "Curve Sketching & Optimization", klasse: 11, area: "analysis",
  x: 1931, y: -1800, requires: ["diff"],
  teaser: "Where does profit peak? Where does the rollercoaster level off? Ask the derivative.",
  desc: "Reading functions like maps – and finding their highest points.",
  exercises: [
    { q: "If f'(x) > 0 on a stretch, then f there is …",
      type: "choice", choices: ["rising", "falling", "flat", "negative"], answer: 0,
      hints: ["f' is the slope.", "Positive slope means …?"],
      why: "The derivative is the function's <b>trend report</b>: sign of f' = direction of f." },
    { q: "At a summit (maximum) of f, what is f'(x)?",
      type: "choice", choices: ["0 – the tangent lies horizontal", "1", "undefined", "negative"], answer: 0,
      hints: ["Stand on the very top of a hill.", "Which direction does the ground slope there?"],
      why: "<b>f' = 0 flags the candidates</b> for peaks and valleys – that's where to search." },
    { q: "f(x) = x² − 6x. f'(x) = 2x − 6 = 0 at x = ?",
      type: "number", answer: 3,
      hints: ["2x = 6.", "x = ?"],
      why: "You just found the parabola's vertex <b>without any vertex formula</b> – calculus generalizes everything before it." },
    { q: "A company's profit P has P'(200) = 0, and P' switches from + to − there. At 200 units …",
      type: "choice", choices: ["profit is at a MAXIMUM", "profit is at a minimum", "nothing special", "the company is broke"], answer: 0,
      hints: ["Before: rising. After: falling.", "What shape does that make at 200?"],
      why: "<b>Optimization</b> – the derivative finds best prices, strongest beams, shortest paths. Math that runs economies." }
  ]
},
{
  id: "kombinatorik", title: "Combinatorics", klasse: 11, area: "daten",
  x: -504, y: -2592, requires: ["wahrsch"],
  teaser: "How many possible PINs, passwords, lottery tickets? Counting without counting.",
  desc: "The art of counting possibilities – the engine room of probability.",
  exercises: [
    { q: "A 4-digit PIN, digits 0-9. How many possible PINs? 10 · 10 · 10 · 10 = ?",
      type: "number", answer: 10000,
      hints: ["Each position: 10 choices, independent.", "10⁴."],
      why: "<b>Multiplication principle</b>: independent choices multiply. Powers count possibilities!" },
    { q: "3 friends line up for a photo. How many different orders? 3 · 2 · 1 = ?",
      type: "number", answer: 6,
      hints: ["First place: 3 choices. Then 2 remain. Then 1.", "That product is called 3! ('factorial')."],
      why: "<b>n! counts arrangements</b>. It explodes fast: 10 people already give 3.6 million orders." },
    { q: "From 5 books, pick 2 for the holidays – order doesn't matter. How many choices?",
      type: "choice", choices: ["10 – (5·4)/2, each pair was counted twice", "20", "25", "7"], answer: 0,
      hints: ["Ordered: 5 · 4 = 20 ways.", "But book A+B is the same holiday bag as B+A."],
      why: "<b>Combinations</b>: divide out the double counting. Order matters? Multiply. It doesn't? Divide." },
    { q: "Lotto '6 of 45' has about 8.1 million possible tickets. Your chance with one ticket …",
      type: "choice",
      choices: ["≈ 1 in 8 million – lightning is more likely", "1 in 45", "1 in 6", "50:50 – win or lose"],
      answer: 0,
      hints: ["Exactly one combination wins.", "Favourable/possible – your probability topic!"],
      why: "Combinatorics <b>feeds</b> probability: count the cases, know the chance. Casinos did this math first." }
  ]
},
{
  id: "bedingt", title: "Conditional Probability", klasse: 11, area: "daten",
  x: 138, y: -2637, requires: ["kombinatorik"],
  teaser: "A test is 99 % accurate. You test positive. The chance you're actually sick can still be below 10 %. Wait, what?",
  desc: "Probabilities that update with knowledge – and the trap almost everyone falls into.",
  exercises: [
    { q: "P(A | B) – 'probability of A given B' – means …",
      type: "choice",
      choices: ["the chance of A, knowing that B happened", "P(A) times P(B)", "the chance of B", "A and B together"],
      answer: 0,
      hints: ["New information shrinks the world of possibilities.", "We only look at cases where B is true."],
      why: "<b>Knowledge changes probabilities</b> – that's conditioning. The | is a 'given that'." },
    { q: "Bag: 3 red, 2 blue. You draw twice without putting back. P(2nd is red GIVEN 1st was red)?",
      type: "number", answer: 0.5,
      hints: ["After a red draw: 2 red and 2 blue remain.", "2 of 4."],
      why: "Drawing <b>without replacement</b>: the situation – and the probability – updates after every draw." },
    { q: "A disease hits 1 in 1000. The test finds 99 % of the sick but false-alarms 1 % of the healthy. Out of 1000 people: ≈1 true positive, ≈10 false alarms. A positive person is really sick with ≈ …",
      type: "choice", choices: ["1 in 11 ≈ 9 %", "99 %", "50 %", "1 %"], answer: 0,
      hints: ["Count the positives: 1 sick + 10 healthy-but-positive = 11.", "Of these 11, how many are sick?"],
      why: "The <b>base-rate trap</b>: rare diseases make false alarms dominate. Doctors get this wrong too – now you won't." },
    { q: "A and B are independent. P(A and B) = ?",
      type: "choice", choices: ["P(A) · P(B)", "P(A) + P(B)", "P(A) − P(B)", "always 0"], answer: 0,
      hints: ["Independent: B tells you nothing about A.", "Two dice: P(six AND six) = 1/6 · 1/6."],
      why: "<b>Independence multiplies</b> – the workhorse formula behind every risk model and every game of chance." }
  ]
},

{
  id: "grenzwert", title: "Limits & Continuity", klasse: 11, area: "analysis",
  x: 1327, y: -2568, requires: ["folgen"],
  teaser: "Get arbitrarily close without ever arriving — the idea that makes all of calculus rigorous.",
  desc: "What a function approaches, and what it means to have no gaps or jumps.",
  exercises: [
    { q: "The limit of x² as x -> 2 equals …",
      type: "number", answer: 4,
      hints: ["Just approach x = 2.","2²."],
      why: "For a <b>continuous</b> function the limit is simply the value — no surprises." },
    { q: "As x -> ∞, the value of 1/x approaches …",
      type: "choice", choices: ["0","1","∞","undefined"], answer: 0,
      hints: ["Divide 1 by ever-larger numbers.","It shrinks to nothing."],
      why: "<b>Limits at infinity</b> describe long-run behaviour — the backbone of asymptotes." },
    { q: "A function is 'continuous' when its graph …",
      type: "choice", choices: ["has no breaks or jumps","is a straight line","always increases","passes through zero"], answer: 0,
      hints: ["Draw it without lifting the pen.","No gaps."],
      why: "<b>Continuity</b> = no holes, jumps or breaks." },
    { q: "Limit of (x² − 1)/(x − 1) as x → 1: cancel to (x + 1), then substitute 1 → ?",
      type: "number", answer: 2,
      hints: ["x²−1 = (x−1)(x+1).","1 + 1."],
      why: "Cancelling removes the <b>0/0</b> trap, leaving a clean value." }
  ]
},
{
  id: "ableitungsregeln", title: "Differentiation Rules", klasse: 11, area: "analysis",
  x: 2056, y: -2032, requires: ["diff"],
  teaser: "Product, quotient, chain — the toolkit that differentiates ANY formula you can write down.",
  desc: "Systematic rules: power, product, quotient and chain rule.",
  exercises: [
    { q: "Using the power rule, the derivative of x³ is 3x². Its value at x = 2 is …",
      type: "number", answer: 12,
      hints: ["3x² with x = 2.","3 · 4."],
      why: "The <b>power rule</b> — bring the exponent down, subtract one — is your daily driver." },
    { q: "The chain rule is needed for …",
      type: "choice", choices: ["a function inside another function","a plain sum","a constant","a single power"], answer: 0,
      hints: ["Think f(g(x)), like (2x+1)⁵.","Nested functions."],
      why: "The <b>chain rule</b> differentiates layers from the outside in." },
    { q: "The derivative of x² is 2x. Its value at x = 5 is …",
      type: "number", answer: 10,
      hints: ["2x with x = 5.","2 · 5."],
      why: "The slope of x² at 5 is <b>10</b> — steeper as x grows." },
    { q: "The derivative of a constant such as 7 is …",
      type: "choice", choices: ["0","1","7","undefined"], answer: 0,
      hints: ["A flat line has no slope.","No change."],
      why: "Constants don't change, so their rate of change is <b>0</b>." }
  ]
},
{
  id: "raumgeraden", title: "Lines in Space", klasse: 11, area: "geometrie",
  x: -1533, y: 2150, requires: ["vektoren"],
  teaser: "A point plus a direction arrow describes any line — now floating in full 3D.",
  desc: "Vector equations of lines in three dimensions.",
  exercises: [
    { q: "To pin down a line in space you need a point and a …",
      type: "choice", choices: ["direction vector","colour","second point only in 2D","radius"], answer: 0,
      hints: ["Position tells you where; direction tells you which way.","An arrow."],
      why: "A line is <b>point + t · direction</b> — the parametric idea generalises to any dimension." },
    { q: "The line (0,0,0) + t·(1,1,1): at t = 3 its z-coordinate is …",
      type: "number", answer: 3,
      hints: ["z = 0 + t·1.","t = 3."],
      why: "Each parameter value slides you along the <b>direction vector</b>." },
    { q: "Two lines in 3D that never meet and are not parallel are called …",
      type: "choice", choices: ["skew","perpendicular","identical","parallel"], answer: 0,
      hints: ["Only possible in 3D.","They pass by without touching."],
      why: "<b>Skew lines</b> exist only in space — flatland has no room for them." },
    { q: "The line (1,0,0) + t·(0,2,0): at t = 4 its y-coordinate is …",
      type: "number", answer: 8,
      hints: ["y = 0 + t·2.","4 · 2."],
      why: "Each step of t moves you along the <b>direction vector</b>." }
  ]
},

/* ================= GRADE 12 ================= */
{
  id: "integral", title: "Integrals", klasse: 12, area: "analysis",
  x: 1557, y: -2399, requires: ["diff"],
  teaser: "Add up infinitely many infinitely thin slices – and get an EXACT area. Calculus' second superpower.",
  desc: "Summing the un-summable: areas, totals, accumulations.",
  exercises: [
    { q: "Area under a curve ≈ sum of thin rectangles. It becomes EXACT when …",
      type: "choice",
      choices: ["the width shrinks toward 0 – a limit!", "the width equals 1", "you use exactly 100 rectangles", "never – it stays approximate"],
      answer: 0,
      hints: ["More, thinner rectangles hug the curve better.", "Which tool turns 'better and better' into 'exact'? You know it from sequences."],
      why: "The integral is a <b>limit of rectangle sums</b> – infinity, tamed again. Same trick as the derivative, other direction." },
    { q: "The Fundamental Theorem of Calculus: integrating is the reverse of …",
      type: "choice", choices: ["differentiating", "adding", "multiplying", "taking roots"], answer: 0,
      hints: ["The two superpowers of calculus are siblings.", "Slope-finding backwards = area-finding."],
      why: "<b>Derivative ⇄ integral</b>: the deepest 'undo' pair in mathematics. That's why both live in one subject: calculus." },
    { q: "∫ of f(x) = 2x from 0 to 3 = area of a triangle: base 3, height 6. So the integral = ?",
      type: "number", answer: 9,
      hints: ["The line y = 2x reaches height 6 at x = 3.", "Triangle: 3 · 6 : 2."],
      why: "For simple shapes, integral = <b>school geometry</b>. The magic is that it also works when no formula exists." },
    { q: "You drive a constant 50 km/h for 2 hours. The area under your speed line = ? (km)",
      type: "number", answer: 100, unit: "km",
      hints: ["A 50-high, 2-wide rectangle.", "50 · 2."],
      why: "<b>Area under speed = distance travelled.</b> The integral of change recovers the total – GPS odometers integrate all day." }
  ]
},
{
  id: "verteilung", title: "Distributions & the Bell Curve", klasse: 12, area: "daten",
  x: -199, y: -2853, requires: ["bedingt"],
  teaser: "Heights, IQs, measurement errors – nature keeps drawing the same bell-shaped curve. Why?",
  desc: "From single chances to the shape of randomness itself.",
  exercises: [
    { q: "Flip 10 coins, count heads, repeat 1000 times and plot. The histogram …",
      type: "choice",
      choices: ["bulges in the middle around 5 – extremes are rare", "is completely flat", "peaks at 10", "looks different every time"],
      answer: 0,
      hints: ["How many of the 1024 outcomes give 5 heads? How many give 10?", "There are MANY paths to the middle, few to the edges. (Combinatorics!)"],
      why: "The <b>binomial distribution</b>: middle results win because more combinations lead there. Counting explains chance." },
    { q: "n = 100 fair coin flips. Expected number of heads = n · p = ?",
      type: "number", answer: 50,
      hints: ["p = 0.5.", "100 · 0.5."],
      why: "<b>Expected value</b> = long-run average. Not a promise for one try – a law for many." },
    { q: "The bell curve (normal distribution) appears whenever …",
      type: "choice",
      choices: ["many small independent effects add up", "data gets sorted", "numbers get squared", "actually never in nature"],
      answer: 0,
      hints: ["Body height: genes + nutrition + … dozens of small pushes.", "Sum of many small random pushes → one famous shape."],
      why: "The <b>Central Limit Theorem</b> – why one curve fits heights, errors and exam scores. Math's most surprising universality." },
    { q: "In a normal distribution, about 2/3 of all values lie within …",
      type: "choice",
      choices: ["1 standard deviation of the mean", "the maximum", "2 means", "the median only"],
      answer: 0,
      hints: ["The σ rule: 68 % within ±1σ.", "68 % ≈ two thirds."],
      why: "<b>σ measures spread</b>: polls, lab results and quality control all speak in standard deviations. You now speak it too." }
  ]
},

{
  id: "hauptsatz", title: "The Fundamental Theorem", klasse: 12, area: "analysis",
  x: 1870, y: -2282, requires: ["integral","diff"],
  teaser: "The bridge between the two superpowers: differentiate an integral and you land right back where you started.",
  desc: "Why integration and differentiation are inverse operations.",
  exercises: [
    { q: "The Fundamental Theorem of Calculus links integrals with …",
      type: "choice", choices: ["derivatives","matrices","prime numbers","vectors"], answer: 0,
      hints: ["The two halves of calculus.","Undo of the slope-finder."],
      why: "<b>Differentiate ⇄ integrate</b>: the theorem proves they undo each other." },
    { q: "∫₀⁴ 2x dx = [x²]₀⁴ = 16 − 0 = ?",
      type: "number", answer: 16,
      hints: ["Antiderivative of 2x is x².","4² − 0²."],
      why: "The theorem turns area into <b>antiderivative in, antiderivative out</b>." },
    { q: "Evaluate ∫₀³ 2x dx = [x²]₀³ = ?",
      type: "number", answer: 9,
      hints: ["Antiderivative x².","3² − 0²."],
      why: "Plug the bounds into the <b>antiderivative</b> — that's the theorem in action." },
    { q: "If F is an antiderivative of f, then ∫ₐᵇ f dx = …",
      type: "choice", choices: ["F(b) − F(a)","F(a) − F(b)","F(b) + F(a)","f(b) − f(a)"], answer: 0,
      hints: ["Top bound minus bottom bound.","End minus start."],
      why: "<b>F(b) − F(a)</b>: the net change of the antiderivative." }
  ]
},
{
  id: "integralanwendung", title: "Areas & Volumes by Integration", klasse: 12, area: "analysis",
  x: 1040, y: -2664, requires: ["integral"],
  teaser: "Slice a solid into infinitely thin discs, integrate — and out pops its exact volume.",
  desc: "Using integrals for areas between curves and volumes of revolution.",
  exercises: [
    { q: "The area under the constant line y = 3 from x = 0 to x = 5 is …",
      type: "number", answer: 15,
      hints: ["It's just a rectangle.","3 · 5."],
      why: "Integrals of simple shapes agree with <b>school geometry</b> — then go further." },
    { q: "A volume of revolution is built by stacking infinitely many thin …",
      type: "choice", choices: ["discs","cubes","triangles","lines"], answer: 0,
      hints: ["Spin a curve around an axis.","Each slice is a circle."],
      why: "<b>Disc integration</b> sums πr² across the axis to get volume." },
    { q: "Area of the triangle under y = x from x = 0 to x = 4 is ½ · 4 · 4 = ?",
      type: "number", answer: 8,
      hints: ["It's a right triangle.","½ · base · height."],
      why: "Integration and <b>triangle geometry</b> agree exactly here." },
    { q: "To find the area BETWEEN two curves you integrate …",
      type: "choice", choices: ["top curve minus bottom curve","top plus bottom","bottom minus top","their average"], answer: 0,
      hints: ["Subtract the lower from the upper.","Gap between them."],
      why: "<b>Upper − lower</b>, integrated, gives the enclosed area." }
  ]
},
{
  id: "dgl", title: "Differential Equations", klasse: 12, area: "analysis",
  x: 1131, y: -2897, requires: ["integral","ableitungsregeln"],
  teaser: "An equation about change itself — how populations grow and hot coffee cools.",
  desc: "Equations linking a quantity to its own rate of change.",
  exercises: [
    { q: "The equation y' = y describes … growth.",
      type: "choice", choices: ["exponential","linear","no","oscillating"], answer: 0,
      hints: ["The rate equals the amount already there.","Bigger -> grows faster."],
      why: "<b>y' = y</b> is solved by e^x — nature's growth curve." },
    { q: "If y' = 0 everywhere, then y must be …",
      type: "choice", choices: ["constant","zero only","negative","increasing"], answer: 0,
      hints: ["No rate of change.","Nothing moves."],
      why: "Zero derivative means a <b>flat, constant</b> solution." },
    { q: "Radioactive decay obeys y′ = −k·y. Its solutions …",
      type: "choice", choices: ["shrink exponentially","grow forever","stay constant","oscillate"], answer: 0,
      hints: ["Negative rate.","Half-life."],
      why: "A negative proportional rate gives <b>exponential decay</b>." },
    { q: "A differential equation is an equation involving a function and its …",
      type: "choice", choices: ["derivative","square root","inverse","factorial"], answer: 0,
      hints: ["It's about rates of change.","y and y′."],
      why: "DEs link a quantity to its own <b>rate of change</b>." }
  ]
},
{
  id: "hypothesentest", title: "Hypothesis Testing", klasse: 12, area: "daten",
  x: -235, y: -3101, requires: ["verteilung"],
  teaser: "Is the coin rigged, or just unlucky? Statistics draws the line between chance and real evidence.",
  desc: "Significance, null hypotheses and decision rules under uncertainty.",
  exercises: [
    { q: "A hypothesis test decides whether a result is …",
      type: "choice", choices: ["plausibly chance, or significant","true forever","big or small","a prime"], answer: 0,
      hints: ["Could randomness alone explain it?","Chance vs. signal."],
      why: "Testing weighs an outcome against <b>what chance would produce</b>." },
    { q: "The null hypothesis usually assumes …",
      type: "choice", choices: ["no effect / nothing special","a huge effect","the experiment failed","certainty"], answer: 0,
      hints: ["The 'boring' baseline you try to reject.","Innocent until proven guilty."],
      why: "The <b>null hypothesis</b> is the default the data must overturn." },
    { q: "A significance level of 5% is the risk of …",
      type: "choice", choices: ["rejecting a true null hypothesis","always being right","measuring twice","a big sample"], answer: 0,
      hints: ["A false alarm.","Crying wolf."],
      why: "The <b>significance level</b> caps the chance of a false positive." },
    { q: "A result very unlikely under the null hypothesis is called …",
      type: "choice", choices: ["statistically significant","the mean","a certainty","the mode"], answer: 0,
      hints: ["Strong evidence against the null.","'Significant'."],
      why: "<b>Significant</b> = too surprising to blame on chance alone." }
  ]
},
{
  id: "matrizen", title: "Matrices & Linear Systems", klasse: 12, area: "algebra",
