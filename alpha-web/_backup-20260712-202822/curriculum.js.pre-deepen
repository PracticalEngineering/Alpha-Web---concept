/* ================= GRADE 6 ================= */
{
  id: "ganze", title: "Negative Numbers", klasse: 6, area: "zahlen",
  x: 1165, y: -846, requires: ["addsub"],
  teaser: "Is there less than nothing? Ask your bank account in the red – or the thermometer in January.",
  desc: "The number line continues to the left: welcome below zero.",
  exercises: [
    { q: "It is −3 °C outside. It gets 8 °C warmer. What is the temperature now (°C)?",
      type: "number", answer: 5, unit: "°C",
      hints: ["Start at −3 on the thermometer and climb 8 marks up.",
              "From −3 to 0 is 3 steps – how many are left?"],
      why: "Negative numbers are <b>places below zero</b> on the number line – computing means walking." },
    { q: "Which number is SMALLER: −7 or −2?",
      type: "choice", choices: ["−7", "−2", "both equal", "can't be said"], answer: 0,
      hints: ["On the number line: smaller = further left.", "−7 lies to the left of −2."],
      why: "With negatives, gut feeling flips: <b>more minus = smaller</b>. (−7° is colder than −2°.)" },
    { q: "(−4) + (−5) = ?",
      type: "number", answer: -9,
      hints: ["Think in debts: €4 of debt plus another €5 of debt.", "Together: €9 of debt."],
      why: "Same signs: add the amounts, keep the sign. <b>Debt + debt = more debt.</b>" },
    { q: "3 − 10 = ?",
      type: "number", answer: -7,
      hints: ["You have €3 but want to spend €10.", "3 − 3 = 0 … and 7 are still missing."],
      why: "Now <b>every</b> subtraction works – never again 'impossible'! Number worlds grow whenever the old ones get too tight." }
  ]
},
{
  id: "ggt-kgv", title: "GCD & LCM", klasse: 6, area: "zahlen",
  x: 1426, y: 200, requires: ["teilbarkeit"],
  teaser: "Two gears mesh together. When do both stand at their start again?",
  desc: "Greatest common divisor and least common multiple – order in the number realm.",
  exercises: [
    { q: "What is the GREATEST common divisor of 12 and 18?",
      type: "number", answer: 6,
      hints: ["Divisors of 12: 1, 2, 3, 4, 6, 12. Divisors of 18: 1, 2, 3, 6, 9, 18.",
              "Which numbers appear in both lists? Take the biggest."],
      why: "<b>GCD</b> = the biggest number that divides both without remainder." },
    { q: "Bus A leaves every 6 min, bus B every 8 min. They just left together. After how many minutes do they leave together again?",
      type: "number", answer: 24, unit: "min",
      hints: ["Bus A: 6, 12, 18, 24, 30, … Bus B: 8, 16, 24, 32, …",
              "Find the first number in both lists."],
      why: "<b>LCM</b> = least common multiple – the rhythm in which cycles meet again (buses, gears, planets!)." },
    { q: "36 red and 48 blue beads must fill identical bags with nothing left over. At most how many bags?",
      type: "number", answer: 12,
      hints: ["The number of bags must divide 36 AND 48.", "So we need the GCD of 36 and 48."],
      why: "GCD in real life: <b>splitting fairly</b> into as many equal groups as possible." },
    { q: "GCD(8,12) = 4 and LCM(8,12) = 24. Compare 4·24 with 8·12. What do you notice?",
      type: "choice",
      choices: ["Both are 96: GCD · LCM = product of the numbers!", "Nothing special", "4·24 is bigger", "8·12 is bigger"],
      answer: 0,
      hints: ["Actually compute both.", "4·24 = 96 and 8·12 = 96."],
      why: "A hidden pattern: <b>GCD·LCM = a·b</b> for every pair. Ask 'why?' and you'll land at prime factors." }
  ]
},
{
  id: "bruchrechnen", title: "Fraction Arithmetic", klasse: 6, area: "zahlen",
  x: 1221, y: 764, requires: ["brueche1", "ggt-kgv"],
  teaser: "1/2 + 1/3 is NOT 2/5. But why not, actually?",
  desc: "Calculating with shares – through understanding instead of rule-magic.",
  exercises: [
    { q: "Why isn't 1/2 + 1/3 simply 2/5?",
      type: "choice",
      choices: ["You can only count parts of equal size", "It is 2/5", "Because you must add the denominators", "Fractions can't be added at all"],
      answer: 0,
      hints: ["Half a pizza and a third of a pizza – are those equal-sized pieces?",
              "First make all pieces the same size (common denominator), THEN count."],
      why: "Adding means counting – and you can only count <b>equal things</b>. Hence: common denominator." },
    { q: "1/2 + 1/3 = ?  (as a simplified fraction, e.g. 7/9)",
      type: "text", answer: "5/6",
      hints: ["Common denominator = LCM of 2 and 3 = 6.", "1/2 = 3/6 and 1/3 = 2/6.", "3 sixths + 2 sixths = ?"],
      why: "Your LCM knowledge makes fractions <b>logical</b>. The web pays off!" },
    { q: "3/4 · 2/5 = ?  (simplified!)",
      type: "text", answer: "3/10",
      hints: ["Top times top, bottom times bottom: 6/20.", "Simplify 6/20: divide both by 2."],
      why: "'times' with fractions means <b>a share of a share</b>: three quarters OF two fifths." },
    { q: "6 : 1/2 = ?",
      type: "choice", choices: ["12", "3", "6.5", "1/3"], answer: 0,
      hints: ["Read the question right: how often does one HALF fit into 6 wholes?",
              "Each whole contains 2 halves – and you have 6 wholes."],
      why: "Dividing by a fraction = multiplying by its <b>reciprocal</b>. Now you know WHY the rule works." }
  ]
},
{
  id: "dezimalrechnen", title: "Decimal Arithmetic", klasse: 6, area: "zahlen",
  x: 805, y: 1194, requires: ["dezimal"],
  teaser: "0.1 + 0.2 makes even computers sweat. You, from now on: never again.",
  desc: "Multiplying, dividing and point-tricks for shops and sport.",
  exercises: [
    { q: "3.6 · 10 = ?",
      type: "number", answer: 36,
      hints: ["Times 10: every digit moves up one place – or in short …", "… the decimal point walks one step to the right."],
      why: "Times/divided by 10, 100, 1000 = <b>let the point walk</b>. The place-value system works for you." },
    { q: "0.4 · 0.3 = ?",
      type: "number", answer: 0.12,
      hints: ["First compute 4 · 3.", "Tenths times tenths gives hundredths."],
      why: "0.4 · 0.3 = 4/10 · 3/10 = 12/100 = 0.12. The <b>decimal places add up</b> – fractions explain why!" },
    { q: "7.2 : 0.9 = ?",
      type: "number", answer: 8,
      hints: ["Shift the point in BOTH numbers equally: 72 : 9.", "How often does 9 fit into 72?"],
      why: "Shifting both numbers equally doesn't change the result – decimal dread becomes times tables." },
    { q: "3 packs at €2.49 each. You pay with a €10 note. Change (€)?",
      type: "number", answer: 2.53, unit: "€",
      hints: ["Trick: 3 · €2.50 = €7.50, take 3 cents back.", "So €7.47. And 10 − 7.47 = ?"],
      why: "With the <b>estimate</b> (≈ €7.50) you instantly notice at the checkout when something's wrong." }
  ]
},
{
  id: "terme1", title: "Variables & Terms", klasse: 6, area: "algebra",
  x: 846, y: -1165, requires: ["multdiv"],
  teaser: "x is not a secret – it's a placeholder. Math becomes a language with wildcard symbols.",
  desc: "The gateway to algebra: thinking in general instead of specific.",
  exercises: [
    { q: "A bag contains x marbles. You have 3 bags and 2 loose marbles. Which term describes your marbles?",
      type: "choice", choices: ["3x + 2", "3 + 2x", "5x", "x + 5"], answer: 0,
      hints: ["3 bags means 3 times x.", "Plus the 2 loose ones."],
      why: "Terms describe a situation <b>in general</b> – no matter how many marbles are in the bag." },
    { q: "The term 3x + 2 for x = 5: what is its value?",
      type: "number", answer: 17,
      hints: ["Substitute 5 for x everywhere.", "3 · 5 + 2 = ?"],
      why: "<b>Substituting</b> turns the general term into a concrete number." },
    { q: "Simplify: 4a + 3a − a",
      type: "choice", choices: ["6a", "7a", "6", "8a"], answer: 0,
      hints: ["4 apples + 3 apples − 1 apple = ?", "4 + 3 − 1 = 6 … of what?"],
      why: "Equal variables may be <b>combined</b> – it's just counting equal things." },
    { q: "Which term means: 'double a number, then make it 7 smaller'?",
      type: "choice", choices: ["2x − 7", "7 − 2x", "2(x − 7)", "x² − 7"], answer: 0,
      hints: ["First double: 2x.", "Then 7 less."],
      why: "Translating language → math: the <b>superpower</b> behind every word problem." }
  ]
},
{
  id: "gleich1", title: "Equations", klasse: 6, area: "algebra",
  x: 494, y: -1353, requires: ["terme1"],
  teaser: "An equation is a balanced scale. Whatever you do on the left, you must do on the right.",
  desc: "The mightiest tool in mathematics: finding the unknown.",
  exercises: [
    { q: "A scale balances: on the left sit x and 3 kg, on the right 10 kg. x = ?",
      type: "number", answer: 7, unit: "kg",
      hints: ["Remove 3 kg from BOTH sides – the scale stays balanced.", "x = 10 − 3."],
      why: "Equations are solved by <b>equal actions on both sides</b> – like a balance scale." },
    { q: "4x = 28  →  x = ?",
      type: "number", answer: 7,
      hints: ["4 identical bags weigh 28 together.", "Divide both sides by 4."],
      why: "Every operation has a <b>reverse</b>: times 4 is undone by dividing by 4." },
    { q: "3x − 5 = 16  →  x = ?",
      type: "number", answer: 7,
      hints: ["First +5 on both sides.", "That leaves 3x = 21."],
      why: "<b>Onion principle</b>: whatever happened to x last is undone first." },
    { q: "I think of a number, double it and add 12. Result: 40. What was my number?",
      type: "number", answer: 14,
      hints: ["Translate: 2x + 12 = 40.", "So 2x = 28."],
      why: "Riddle → equation → solution. Algebra is a <b>riddle machine</b>." }
  ]
},
{
  id: "dreieck", title: "Triangles", klasse: 6, area: "geometrie",
  x: -1150, y: 867, requires: ["winkel"],
  teaser: "Why are pylons and cranes full of triangles – and never full of squares?",
  desc: "The most stable shape in the world and its 180° secret.",
  exercises: [
    { q: "In every triangle α + β + γ = 180°. Given: α = 63°, β = 71°. How big is γ?",
      type: "number", answer: 46, unit: "°",
      hints: ["180 − 63 − 71.", "180 − 134 = ?"],
      why: "Angle sum 180°: tear the three corners off a paper triangle and lay them side by side – they form a <b>straight line</b>!" },
    { q: "Can a triangle have TWO right angles?",
      type: "choice",
      choices: ["No – 90+90 = 180, leaving 0° for the third angle", "Yes, it's called a rectangle-triangle", "Only if it's big enough", "Yes, in obtuse triangles"],
      answer: 0,
      hints: ["Think of the angle sum: 180°!", "90 + 90 = 180. What's left for the third angle?"],
      why: "From one rule follow many truths – that is <b>logical deduction</b>, the heart of mathematics." },
    { q: "You have rods of 3 cm, 4 cm and 8 cm. Can you form a triangle from them?",
      type: "choice",
      choices: ["No – 3+4 < 8, the short rods can't reach each other", "Yes, always", "Only a right-angled one", "Yes, if you bend the rods"],
      answer: 0,
      hints: ["Attach the two short rods to the ends of the long one.", "3 + 4 = 7 < 8: the arms are too short to meet."],
      why: "<b>Triangle inequality</b>: two sides together must exceed the third. The straight path is always shortest!" },
    { q: "Why are cranes and bridges built from triangles?",
      type: "choice",
      choices: ["A triangle cannot change its shape – it is rigid", "It looks nicer", "Triangles are always lighter", "Chance and tradition"],
      answer: 0,
      hints: ["A four-sided frame can be squashed into a diamond shape. A triangle?",
              "Three fixed side lengths pin down the shape completely."],
      why: "Three sides determine a triangle <b>uniquely</b> (SSS) – that's why it's rigid, and why geometry holds up bridges." }
  ]
},
{
  id: "viereck", title: "Quadrilaterals", klasse: 6, area: "geometrie",
  x: -1409, y: 298, requires: ["dreieck", "symmetrie"],
  teaser: "Square, rectangle, rhombus, parallelogram – one family with a strict family tree.",
  desc: "Who belongs to whom? Properties decide.",
  exercises: [
    { q: "Is every square also a rectangle?",
      type: "choice",
      choices: ["Yes – it fulfils everything a rectangle demands", "No, it's the other way round", "Only if it's small", "Squares aren't quadrilaterals at all"],
      answer: 0,
      hints: ["Rectangle condition: four right angles. Does the square have them?",
              "It fulfils even more: four equal sides on top."],
      why: "Concepts form a <b>family tree</b>: the square is a especially regular rectangle." },
    { q: "What is the angle sum in a quadrilateral?",
      type: "number", answer: 360, unit: "°",
      hints: ["Cut the quadrilateral along a diagonal. What appears?", "Two triangles of 180° each."],
      why: "<b>Reducing the new to the known</b> – the most important thinking trick in all of mathematics." },
    { q: "Which quadrilateral has 4 equal sides but not necessarily right angles?",
      type: "choice", choices: ["rhombus", "rectangle", "trapezium", "kite"], answer: 0,
      hints: ["Imagine a square that someone pushed sideways.", "All sides stay equal – only the angles change."],
      why: "Rhombus = equilateral parallelogram. <b>Properties</b> determine the name, not the looks." },
    { q: "In a parallelogram, opposite angles are …",
      type: "choice", choices: ["equal", "90° together", "always right angles", "always acute"], answer: 0,
      hints: ["Draw one and measure!", "Rotate the parallelogram 180° around its centre – it covers itself."],
      why: "Parallel sides force equal opposite angles – your grade-5 <b>symmetry</b> at work!" }
  ]
},
{
  id: "flaeche2", title: "Triangle & Parallelogram Area", klasse: 6, area: "geometrie",
  x: -677, y: 1271, requires: ["rechteck", "dreieck"],
  teaser: "Every parallelogram is a rectangle in disguise. You just have to cut it right!",
  desc: "New area formulas – understood, not memorized.",
  exercises: [
    { q: "A parallelogram with base 8 cm and height 5 cm. How do you find its area?",
      type: "choice",
      choices: ["Cut off a corner triangle on the left, attach it on the right → rectangle 8×5", "Compute 8 · 5 · 2", "Compute (8+5) · 2", "Only by measuring on grid paper"],
      answer: 0,
      hints: ["Cut off a right-angled triangle on the left.", "Slide it over to the right side. What shape appears?"],
      why: "A = b·h, because every parallelogram can be <b>turned into a rectangle</b>. Formulas have reasons!" },
    { q: "So: parallelogram with b = 8 cm, h = 5 cm. A = ? (cm²)",
      type: "number", answer: 40, unit: "cm²",
      hints: ["A = b · h.", "8 · 5 = ?"],
      why: "Classic trap: the height is <b>perpendicular</b> to the base – don't use the slanted side!" },
    { q: "Why is the triangle area b·h : 2?",
      type: "choice",
      choices: ["Two copies of the triangle form a parallelogram", "Because 3 corners are half of 6", "Triangles are half squares", "Pure convention among mathematicians"],
      answer: 0,
      hints: ["Copy the triangle, rotate the copy 180° and attach it to the longest side.",
              "Original + copy = which shape?"],
      why: "The triangle is <b>half a parallelogram</b> → A = b·h/2. Again: new built from known." },
    { q: "Triangle with b = 10 cm and h = 7 cm. A = ? (cm²)",
      type: "number", answer: 35, unit: "cm²",
      hints: ["b · h : 2.", "70 : 2 = ?"],
      why: "With triangles you can compute <b>any</b> straight-edged shape – just cut it into triangles!" }
  ]
},
{
  id: "prisma", title: "Prisms", klasse: 6, area: "geometrie",
  x: -75, y: 1438, requires: ["quader", "flaeche2"],
  teaser: "Toblerone, tents, attic rooms: all prisms! Base area times height – that's all it takes.",
  desc: "Solids with a constant cross-section – the cuboid idea goes general.",
  exercises: [
    { q: "What makes a solid a prism?",
      type: "choice",
      choices: ["The same cross-section everywhere – like a base pulled upwards", "It is pointy", "It has exactly 6 faces", "It is round"],
      answer: 0,
      hints: ["Think of a salami: wherever you cut (straight) …", "… the slice always looks the same."],
      why: "Constant cross-section means: <b>stacking layers</b> works – hence V = G · h." },
    { q: "Toblerone box: triangular base 12 cm², length 20 cm. Volume (cm³)?",
      type: "number", answer: 240, unit: "cm³",
      hints: ["V = G · h.", "12 · 20 = ?"],
      why: "The cuboid formula was just a special case – <b>V = G·h</b> holds for every prism." },
    { q: "A tent is a lying triangular prism: gable triangle b = 2 m, h = 1.5 m, tent length 3 m. Volume (m³)?",
      type: "number", answer: 4.5, unit: "m³",
      hints: ["First the triangle area: 2 · 1.5 : 2.", "G = 1.5 m². Now times the length."],
      why: "<b>Chaining formulas</b>: triangle area → prism volume. Your knowledge web works as a team." },
    { q: "Backwards: a prism has V = 100 cm³ and G = 25 cm². How high is it?",
      type: "choice", choices: ["4 cm", "2500 cm", "75 cm", "0.25 cm"], answer: 0,
      hints: ["V = G · h  →  solve for h.", "100 : 25 = ?"],
      why: "Formulas are <b>equations</b> – you can solve them for any quantity. Algebra meets geometry." }
  ]
},
{
  id: "schluss", title: "Proportional Reasoning", klasse: 6, area: "groessen",
  x: -1305, y: -609, requires: ["groessen"],
  teaser: "3 scoops of ice cream cost €4.50. What do 5 cost? The rule of three cracks a thousand everyday questions.",
  desc: "Thinking in proportions: possibly the most useful everyday math tool.",
  exercises: [
    { q: "3 scoops of ice cream cost €4.50. What does 1 scoop cost (€)?",
      type: "number", answer: 1.5, unit: "€",
      hints: ["Scale down to ONE scoop.", "4.50 : 3 = ?"],
      why: "<b>Down to the unit</b>: first the value of ONE – then you can find the value of any amount." },
    { q: "And what do 5 scoops cost (€)?",
      type: "number", answer: 7.5, unit: "€",
      hints: ["1 scoop = €1.50.", "5 · 1.50 = ?"],
      why: "<b>Directly proportional</b>: double the amount → double the price. Down to 1, up to anything." },
    { q: "4 painters paint a house in 6 days. How long do 8 painters need (days)?",
      type: "number", answer: 3, unit: "days",
      hints: ["Careful: MORE painters need LESS time – it flips!",
              "Total work: 4 · 6 = 24 painter-days.", "24 : 8 = ?"],
      why: "<b>Inversely proportional</b>: the product stays constant. Not every relation is 'the more, the more'!" },
    { q: "Which relationship is NOT proportional?",
      type: "choice",
      choices: ["A person's height and their age", "Amount of petrol and price", "Number of bread rolls and price", "Hours worked and pay at a fixed hourly rate"],
      answer: 0,
      hints: ["Proportional means: twice as much → twice as big, ALWAYS.",
              "Are you twice as tall at 30 as at 15?"],
      why: "<b>Think before computing</b>: does the model even fit? That's how real researchers work." }
  ]
},
{
  id: "prozent1", title: "Percentages", klasse: 6, area: "groessen",
  x: -1024, y: -1096, requires: ["schluss", "brueche1"],
  teaser: "'50 % off the discount' – whoever understands percentages doesn't get fooled in the sale.",
  desc: "Shares in everyday language: hundredths for all occasions.",
  exercises: [
    { q: "What does 25 % mean?",
      type: "choice", choices: ["25 out of 100 – a quarter", "25 of any number", "one twenty-fifth", "double of 12.5"], answer: 0,
      hints: ["'per cent' is Latin: 'out of one hundred'.", "25/100 – simplify that fraction!"],
      why: "Percent = fraction with denominator 100 = decimal: <b>25 % = 25/100 = 1/4 = 0.25</b>. Four notations, one idea." },
    { q: "20 % of €150 = ? (€)",
      type: "number", answer: 30, unit: "€",
      hints: ["First find 10 %: just divide by 10 → €15.", "20 % = 2 · 10 %."],
      why: "The <b>10 % trick</b> turns almost every percentage into mental math." },
    { q: "Jeans cost €80, today 25 % off. New price (€)?",
      type: "number", answer: 60, unit: "€",
      hints: ["25 % of €80 = a quarter of 80.", "80 − 20 = ?"],
      why: "Discount: compute the percent value and subtract – or take 75 % directly. Two roads, one destination." },
    { q: "You improve from 20 to 25 points. By what percentage did you improve?",
      type: "choice", choices: ["25 %", "5 %", "20 %", "500 %"], answer: 0,
      hints: ["The gain is 5 points. But 5 out of WHAT?",
              "Always from the STARTING value: 5 out of 20 = 5/20 = 1/4."],
      why: "Percent always needs a <b>reference value</b> – even newspapers overlook that. You won't anymore." }
  ]
},
{
  id: "binaer", title: "Binary Numbers", klasse: 6, area: "info",
  x: 51, y: -1439, requires: ["zahlen100"],
  teaser: "Computers know only 0 and 1 – and still store this whole website. How?",
  desc: "Your place-value system with base 2 instead of 10. The alphabet of every computer.",
  exercises: [
    { q: "In binary the places are worth 1, 2, 4, 8, … (instead of 1, 10, 100). What is 101₂ in decimal?",
      type: "choice", choices: ["5", "101", "3", "6"], answer: 0,
      hints: ["Read from the right: ones place, twos place, fours place.",
              "1·4 + 0·2 + 1·1 = ?"],
      why: "Place value works with <b>any base</b> – you just re-used your place-value knowledge in base 2!" },
    { q: "1101₂ = ? (decimal)",
      type: "number", answer: 13,
      hints: ["Places from the right: 1, 2, 4, 8.", "8 + 4 + 0 + 1 = ?"],
      why: "Every number has a binary name – computers store exactly these 0/1 patterns." },
    { q: "Write 6 in binary (just the digits, e.g. 1010).",
      type: "number", answer: 110,
      hints: ["Which powers of two add up to 6?", "6 = 4 + 2 → one four, one two, zero ones."],
      why: "Translating in both directions – you now speak the computer's native language." },
    { q: "Why do computers use binary of all things?",
      type: "choice",
      choices: ["Two states (on/off) are easy and reliable for electronics", "Binary numbers are shorter", "0 and 1 look nice", "They can't afford more digits"],
      answer: 0,
      hints: ["A switch, a voltage, a tiny magnet: what can they represent easily?", "On or off – nothing in between to confuse."],
      why: "Engineering choice, not magic: <b>robust simplicity</b>. From here: bits, bytes, and all of computing." }
  ]
},
{
  id: "speed", title: "Physics: Speed", klasse: 6, area: "physik",
  x: -630, y: -1294, requires: ["schluss"],
  teaser: "v = distance ÷ time. Your first physics formula is … proportional reasoning!",
  desc: "Physics begins exactly here: measuring motion with math.",
  exercises: [
    { q: "A cyclist rides 24 km in 2 hours. Speed (km/h)?",
      type: "number", answer: 12, unit: "km/h",
      hints: ["Speed = distance per ONE hour.", "24 : 2 = ?"],
      why: "v = s/t is <b>down-to-the-unit</b> from proportional reasoning – physics recycles your math." },
    { q: "A car drives at 90 km/h. How far does it get in 20 minutes (km)?",
      type: "number", answer: 30, unit: "km",
      hints: ["20 minutes is a third of an hour.", "90 : 3 = ?"],
      why: "Formulas work <b>in every direction</b>: from v and t back to the distance s = v·t." },
    { q: "Thunder arrives 6 s after the lightning. Sound travels ≈ 340 m/s, light (almost) instantly. How far is the storm?",
      type: "choice",
      choices: ["≈ 2 km (340 · 6 = 2040 m)", "≈ 340 m", "≈ 6 km", "impossible to know"],
      answer: 0,
      hints: ["The light reaches you immediately, the sound needs the 6 s.", "distance = speed · time = 340 · 6."],
      why: "Physics = math + meaning. Rule of thumb: <b>3 seconds ≈ 1 km</b> of storm distance." },
    { q: "World record: 100 m in 9.58 s. Average speed ≈ ? m/s (1 decimal)",
      type: "number", answer: 10.4, tol: 0.06, unit: "m/s",
      hints: ["distance : time.", "100 : 9.58 ≈ ?"],
      why: "Over 37 km/h! <b>Units carry meaning</b>: m/s, km/h – always say what per what." }
  ]
},
{
  id: "dichte", title: "Physics: Density", klasse: 6, area: "physik",
  x: -298, y: -1409, requires: ["groessen"],
  teaser: "A steel ship floats, a steel ball sinks. The secret is mass per volume.",
  desc: "Why things float or sink – Archimedes' bathtub discovery.",
  exercises: [
    { q: "Density = mass : volume. Water: 1 g per cm³. A block has 100 g and 50 cm³. Its density?",
      type: "choice",
      choices: ["2 g/cm³ – it sinks in water", "0.5 g/cm³ – it floats", "50 g/cm³", "100 g/cm³"],
      answer: 0,
      hints: ["100 : 50 = ?", "More than 1 g/cm³ means: heavier than water → sinks."],
      why: "<b>Density</b> decides floating or sinking – not weight alone! A giant log floats, a tiny pebble sinks." },
    { q: "Gold has density 19.3 g/cm³. A nugget of 2 cm³ weighs ? (g)",
      type: "number", answer: 38.6, tol: 0.05, unit: "g",
      hints: ["Every cm³ weighs 19.3 g.", "19.3 · 2 = ?"],
      why: "Density is a <b>fingerprint</b> of materials – that's how you unmask fake gold." },
    { q: "Why does a ship made of steel float?",
      type: "choice",
      choices: ["Its shape encloses lots of air – the AVERAGE density is below water", "Steel is lighter than water", "The waves push it up", "Salt in the sea holds it"],
      answer: 0,
      hints: ["The ship isn't solid steel – what's inside the hull?", "Steel + lots of air, averaged: lighter than water per cm³."],
      why: "It's the average density of the <b>whole body</b> that counts. Submarines play exactly this game with tanks of water and air." },
    { q: "A stone displaces 40 cm³ of water and has mass 100 g. Density (g/cm³)?",
      type: "number", answer: 2.5, unit: "g/cm³",
      hints: ["The displaced water reveals the volume – Archimedes' bathtub trick ('Eureka!').", "100 : 40 = ?"],
      why: "Measure the unmeasurable: <b>displacement</b> gives the volume of any odd shape." }
  ]
},

{
  id: "licht", title: "Light & Shadows", klasse: 6, area: "physik",
  x: -563, y: -1577, requires: ["geo-grund"],
  teaser: "Light races in perfectly straight lines — block it and a shadow is born.",
  desc: "How light travels, and why shadows form and change size.",
  exercises: [
    { q: "Light travels in …",
