/* ================= GRADE 8 ================= */
{
  id: "wurzeln", title: "Roots & Irrational Numbers", klasse: 8, area: "zahlen",
  x: 1878, y: -399, requires: ["potenzen", "rational"],
  teaser: "Write √2 as a fraction? The ancient Greeks were sure it must work – until one of them proved it can't. Scandal!",
  desc: "The reverse of squaring – and numbers beyond all fractions.",
  exercises: [
    { q: "√81 = ?",
      type: "number", answer: 9,
      hints: ["We need the number that times itself gives 81.", "9 · 9 = ?"],
      why: "Taking a root = <b>reversing</b> squaring. Every operation has its reverse gear." },
    { q: "A square plot has an area of 625 m². How long is one side (m)?",
      type: "number", answer: 25, unit: "m",
      hints: ["We need √625.", "20² = 400 and 30² = 900 – it's in between. Which last digit squares to a 5?"],
      why: "Roots answer geometry's <b>backwards questions</b>: from area to side." },
    { q: "Between which two whole numbers does √50 lie?",
      type: "choice", choices: ["7 and 8", "6 and 7", "8 and 9", "49 and 51"], answer: 0,
      hints: ["7² = 49 and 8² = 64.", "50 is just above 49."],
      why: "<b>Bracketing</b>: even without a calculator you know where the number lives – √50 ≈ 7.07." },
    { q: "√2 = 1.41421356… What is special about this number?",
      type: "choice",
      choices: ["It runs forever without a pattern – impossible as a fraction (irrational)", "It ends after 8 digits", "It equals exactly 1.5", "It repeats like 0.333…"],
      answer: 0,
      hints: ["1/3 = 0.3333… repeats nicely. And √2?", "It can be PROVEN: no fraction in the world hits √2 exactly."],
      why: "There are numbers <b>beyond the fractions</b>: irrational ones. With them the number line finally becomes full – the real numbers ℝ." }
  ]
},
{
  id: "linfunk", title: "Linear Functions", klasse: 8, area: "algebra",
  x: 816, y: -1672, requires: ["gleich1", "koord"],
  teaser: "Taxi: €4 base fare + €2 per km. One formula, one straight line – and you see every price at a glance.",
  desc: "Relationships as formula AND picture: functions connect everything.",
  exercises: [
    { q: "Taxi: y = 2x + 4 (x = kilometres, y = price in €). What does a 5 km ride cost (€)?",
      type: "number", answer: 14, unit: "€",
      hints: ["Substitute x = 5.", "2 · 5 + 4 = ?"],
      why: "A function is a <b>machine</b>: kilometres in, price out." },
    { q: "y = 2x + 4: what does the 4 mean in the graph?",
      type: "choice",
      choices: ["The start on the y-axis (value at x = 0)", "The slope of the line", "The length of the line", "The largest x value"],
      answer: 0,
      hints: ["What does a ride of 0 km cost? The base fare!", "Where does the line cross the y-axis?"],
      why: "y = kx + d: <b>d = starting value</b> (y-intercept), <b>k = slope</b> (price per km). Formula and picture tell the same story." },
    { q: "Which line is steeper: y = 3x + 1 or y = 2x + 7?",
      type: "choice", choices: ["y = 3x + 1", "y = 2x + 7", "equally steep", "depends on x"], answer: 0,
      hints: ["Steepness = how much y grows per step in x.", "3 per step versus 2 per step."],
      why: "k is the <b>slope</b> – the d only lifts the line, it doesn't tilt it." },
    { q: "Plan A: €10 fixed + €0.10/min. Plan B: €0.30/min, no fixed fee. At how many minutes do both cost the same?",
      type: "number", answer: 50, unit: "min",
      hints: ["Set equal: 10 + 0.1x = 0.3x.", "10 = 0.2x. So x = ?"],
      why: "The <b>intersection</b> of two lines answers decision questions – functions + equations = everyday power." }
  ]
},
{
  id: "gls", title: "Systems of Equations", klasse: 8, area: "algebra",
  x: 399, y: -1878, requires: ["linfunk"],
  teaser: "5 animals, 14 legs, only rabbits and chickens. How many rabbits? Two unknowns – one detective story.",
  desc: "Two unknowns, two equations: solvable together.",
  exercises: [
    { q: "Rabbits (4 legs) and chickens (2 legs): 5 heads and 14 legs in total. Which two equations fit (r = rabbits, c = chickens)?",
      type: "choice",
      choices: ["r + c = 5  and  4r + 2c = 14", "r + c = 14  and  r·c = 5", "4r = 2c  and  r + c = 14", "r − c = 5  and  4r + 2c = 14"],
      answer: 0,
      hints: ["Heads: every animal has exactly one.", "Legs: each rabbit brings 4, each chicken 2."],
      why: "Two unknowns need <b>two pieces of information</b> – each becomes an equation." },
    { q: "Solve: r + c = 5 and 4r + 2c = 14. How many rabbits?",
      type: "number", answer: 2,
      hints: ["From the first equation: c = 5 − r. Substitute into the second!",
              "4r + 2(5 − r) = 14  →  4r + 10 − 2r = 14.", "2r = 4."],
      why: "<b>Substitution</b>: express one unknown by the other – two equations become one. (Check: 2 rabbits + 3 chickens = 8 + 6 = 14 legs ✓)" },
    { q: "x + y = 10 and x − y = 4. x = ?",
      type: "number", answer: 7,
      hints: ["Add the two equations – what happens to y?", "+y and −y cancel: 2x = 14."],
      why: "<b>Elimination</b>: equations may be added. Eliminate instead of guessing!" },
    { q: "2 coffees + 1 cake = €7. 1 coffee + 1 cake = €5. What does a coffee cost?",
      type: "choice", choices: ["€2", "€3", "€2.50", "€1"], answer: 0,
      hints: ["Compare the two orders: the difference is exactly 1 coffee.", "7 − 5 = ?"],
      why: "The <b>difference view</b>: sharp looking sometimes solves a system faster than any method." }
  ]
},
{
  id: "kreis", title: "The Circle & π", klasse: 8, area: "geometrie",
  x: -1181, y: 1514, requires: ["flaeche2"],
  teaser: "Circumference divided by diameter – for EVERY circle in the world, out comes the same number: 3.14159…",
