      why: "An <b>algorithm</b> is a precise recipe of steps — the heart of computing." },
    { q: "The steps of an algorithm must be done …",
      type: "choice", choices: ["in the right order","in any order","all at once","backwards"], answer: 0,
      hints: ["Socks before shoes!","Order matters."],
      why: "<b>Order matters</b> — the right steps in the wrong order fail." },
    { q: "A cooking recipe is like an algorithm because it …",
      type: "choice", choices: ["gives ordered steps","always tastes good","needs a computer","never ends"], answer: 0,
      hints: ["Do this, then that.","Step by step."],
      why: "Recipes are everyday <b>algorithms</b> — ordered instructions to a result." },
    { q: "A good algorithm is …",
      type: "choice", choices: ["clear and unambiguous","vague","secret","impossible"], answer: 0,
      hints: ["No room for confusion.","A computer can't guess."],
      why: "Algorithms must be <b>unambiguous</b> — computers follow them literally." }
  ]
},

{
