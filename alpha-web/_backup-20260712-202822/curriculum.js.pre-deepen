{
  id: "zahlen1", title: "Counting", klasse: 1, area: "zahlen",
  x: 0, y: 0, requires: [],
  teaser: "One, two, three … how far do numbers go? Further than the stars!",
  desc: "The very first step of the whole web: counting. Everything else grows from here.",
  exercises: [
    { q: "You count up: 1, 2, 3, 4, 5, 6, 7 … What comes right after 7?",
